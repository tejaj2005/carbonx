PORT=8765
HOST=127.0.0.1
DATA_DIR=.data
COOKIE_SECURE=false
ALLOW_DEMO=true
ALLOW_REGISTRATION=true
# Optional hosted AI. Secrets remain on the server.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ENABLE_HOSTED_AI=false
ENABLE_OCR=true
MAX_UPLOAD_MB=25
# Optional local path to traineddata files; otherwise Tesseract downloads English on first OCR run.
OCR_LANG_PATH=
