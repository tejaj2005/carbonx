# Local website
PORT=8765
HOST=127.0.0.1
DATA_DIR=.data
COOKIE_SECURE=false
ALLOW_DEMO=true
ALLOW_REGISTRATION=true
MAX_UPLOAD_MB=25
ENABLE_OCR=true
OCR_LANG_PATH=

# Grok (xAI). Add your key below; no local AI model is required.
# Your uploaded report passages / selected evidence are sent to xAI when AI actions run.
# Grok uses your API credits/billing. No AI request is made while the key is blank.
AI_PROVIDER=xai
ENABLE_HOSTED_AI=true
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Public environmental APIs: already configured; no keys needed.
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
EARTH_SEARCH_STAC_URL=https://earth-search.aws.element84.com/v1

# Automatic city updates
ENABLE_MONITORING=true
MONITOR_POLL_MINUTES=30

# Optional: your free personal data.gov.in key for official CPCB station summaries.
# Weather/model AQ and satellite requests work without this key.
DATA_GOV_IN_API_KEY=

# The separate legacy OpenAI adapter remains disabled.
ALLOW_PAID_AI=false
