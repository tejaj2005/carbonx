PORT=8765
HOST=127.0.0.1
DATA_DIR=.data
COOKIE_SECURE=false
ALLOW_DEMO=true
ALLOW_REGISTRATION=true
MAX_UPLOAD_MB=25
ENABLE_OCR=true
OCR_LANG_PATH=
# Free local AI. Install an explicitly LOCAL model yourself; no model downloads are triggered by CarbonX.
AI_PROVIDER=ollama
OLLAMA_MODEL=
OLLAMA_EMBEDDING_MODEL=
# Metro polling is bounded to a minimum of 15 minutes to respect free-provider limits.
ENABLE_MONITORING=true
MONITOR_POLL_MINUTES=30
# Optional FREE personal OGD key for official CPCB station summaries. Keep it out of Git and chat.
DATA_GOV_IN_API_KEY=
# No paid AI requests are permitted by the default configuration.
ALLOW_PAID_AI=false
