# Local website
PORT=8765
HOST=127.0.0.1
DATA_DIR=.data
COOKIE_SECURE=false
ALLOW_DEMO=true
ALLOW_REGISTRATION=true
MAX_UPLOAD_MB=25
ENABLE_OCR=true
OCR_LANG_PATH=

# Groq hosted AI. Save a newly rotated key here; no local model is needed.
# Selected report passages/evidence go to Groq when AI actions run.
# Free-tier limits and model access depend on your Groq account.
AI_PROVIDER=groq
ENABLE_HOSTED_AI=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional alternative only: select AI_PROVIDER=xai to use Grok.
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Keyless environmental sources
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
EARTH_SEARCH_STAC_URL=https://earth-search.aws.element84.com/v1
# Keep earth-search until your own Copernicus OAuth client is configured.
# Set SATELLITE_PROVIDER=sentinelhub to use the credential-based adapter.
SATELLITE_PROVIDER=earth-search
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

ENABLE_MONITORING=true
MONITOR_POLL_MINUTES=30
# Optional free personal data.gov.in key for official CPCB station summaries.
DATA_GOV_IN_API_KEY=
ALLOW_PAID_AI=false

# Supabase read-only connection verification; application records still use SQLite.
# Run supabase:check to verify connections; application Auth/storage are not migrated. Never use VITE_ for secrets.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

# Optional separate password record; SUPABASE_DB_URL contains its encoded value.
SUPABASE_DB_PASSWORD=
